  <!-- 媒体状态上报 -->
  <string name="media_listener_label">SleepyXposed 媒体监听</string>
  <string name="media_section_title">媒体状态上报</string>
  <string name="media_section_description">可选功能：将当前正在播放的媒体（标题/艺术家）作为独立设备上报到您的 Sleepy 服务器。</string>
