<resources>
    <string name="app_name">SleepyXposed</string>
    <string name="xposed_description">Monitor foreground app switches and report to Sleepy server</string>
    <string name="config_description">Configure your Sleepy server connection. This Xposed module
        will automatically report your device status and current app to the server.</string>
    <string name="instructions">Instructions:\n1. Fill in your Sleepy server base URL (e.g.,
        https://sleepy.example.com)\n2. Enter your server secret key\n3. Set a unique
        device ID\n4. Choose a display name for this device\n5. Enable reporting with the switch\n6.
        Save and reboot your device\n7. Enable this module in LSPosed/Xposed and select \'System
        Framework\' as scope\n\nNote: The module only works when enabled in Xposed/LSPosed manager.</string>

